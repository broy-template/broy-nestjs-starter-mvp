# 🔐 Production Security Configuration
# Copy this to .env.production dan sesuaikan dengan environment production

# ==============================================
# FILE UPLOAD SECURITY - PRODUCTION
# ==============================================

# Storage Configuration
UPLOADS_DIR="./uploads/private"
MAX_FILE_SIZE=5242880                    # 5MB untuk production (lebih ketat)

# Stricter MIME Type Control (production)
ALLOWED_MIME_TYPES="image/jpeg,image/png,application/pdf"

# Allowed Extensions (production - minimal)
ALLOWED_EXTENSIONS=".jpg,.jpeg,.png,.pdf"

# Enhanced Dangerous Extensions Blocking
DANGEROUS_EXTENSIONS=".exe,.bat,.cmd,.com,.pif,.scr,.vbs,.js,.jar,.php,.asp,.aspx,.jsp,.sh,.bash,.ps1,.py,.rb,.pl,.go,.rs,.c,.cpp,.h,.hpp,.class,.dex,.apk,.ipa,.dmg,.pkg,.msi,.rpm,.deb,.tar,.gz,.7z,.rar,.zip,.war,.ear"

# Security Features (production)
ENABLE_ANTIVIRUS_SCAN=true               # Enable di production
ENABLE_METADATA_STRIPPING=true

# Rate Limiting (production - stricter)
UPLOAD_RATE_LIMIT=3                      # 3 uploads per minute
UPLOAD_RATE_TTL=60000                    # 1 minute
DELETE_RATE_LIMIT=5                      # 5 deletes per minute
DELETE_RATE_TTL=60000                    # 1 minute

# ==============================================
# CLOUD STORAGE (Optional - S3/MinIO)
# ==============================================

# AWS S3 Configuration
# AWS_REGION="us-east-1"
# AWS_BUCKET_NAME="your-app-uploads"
# AWS_ACCESS_KEY_ID="your-access-key"
# AWS_SECRET_ACCESS_KEY="your-secret-key"

# File URL Configuration
# UPLOAD_BASE_URL="https://your-cdn.com/files"
# UPLOAD_SIGNED_URL_EXPIRES=3600           # 1 hour

# ==============================================
# ANTIVIRUS CONFIGURATION
# ==============================================

# ClamAV Configuration
# CLAMAV_HOST="localhost"
# CLAMAV_PORT=3310
# CLAMAV_TIMEOUT=30000                     # 30 seconds

# ==============================================
# MONITORING & LOGGING
# ==============================================

# Security Event Logging
LOG_SECURITY_EVENTS=true
LOG_FILE_ACCESS=true
LOG_FAILED_UPLOADS=true

# Monitoring Integration
# DATADOG_API_KEY="your-datadog-key"
# SENTRY_DSN="your-sentry-dsn"

# ==============================================
# ADVANCED SECURITY
# ==============================================

# File Encryption (for sensitive data)
# ENABLE_FILE_ENCRYPTION=true
# ENCRYPTION_KEY="your-32-byte-encryption-key"
# ENCRYPTION_ALGORITHM="aes-256-gcm"

# Image Processing Security
ENABLE_IMAGE_PROCESSING=true
MAX_IMAGE_WIDTH=2048
MAX_IMAGE_HEIGHT=2048
STRIP_EXIF_DATA=true

# Content Security Policy for file serving
CSP_FILE_SERVE="default-src 'none'; img-src 'self'; object-src 'none';"

# ==============================================
# BACKUP & RETENTION
# ==============================================

# File Retention Policy
ENABLE_FILE_RETENTION=true
FILE_RETENTION_DAYS=365                  # Keep files for 1 year
CLEANUP_DELETED_FILES_DAYS=30            # Permanently delete after 30 days

# Backup Configuration
# ENABLE_FILE_BACKUP=true
# BACKUP_SCHEDULE="0 2 * * *"             # Daily at 2 AM
# BACKUP_RETENTION_DAYS=90
