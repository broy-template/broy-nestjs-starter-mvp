# ==============================================
# APPLICATION CONFIGURATION
# ==============================================

# Environment (development, staging, production)
NODE_ENV=development
PORT=3000
API_PREFIX=api/v1

# Application Settings
APP_NAME="Broy NestJS Starter MVP"
APP_VERSION="1.0.0"
APP_DESCRIPTION="NestJS Starter for MVP Development"
APP_TIMEZONE=UTC

# ==============================================
# DATABASE CONFIGURATION
# ==============================================

# PostgreSQL Database
DATABASE_URL="postgresql://username:password@localhost:5432/database_name?schema=public"

# Database Pool Settings (optional)
DB_POOL_MIN=2
DB_POOL_MAX=10

# ==============================================
# SECURITY CONFIGURATION
# ==============================================

# JWT Configuration - CHANGE THESE IN PRODUCTION!
JWT_SECRET="your-super-secret-jwt-key-change-this-in-production-min-32-chars"
JWT_REFRESH_SECRET="your-super-secret-refresh-jwt-key-change-this-in-production-min-32-chars"
JWT_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"

# Password Hashing
BCRYPT_ROUNDS=12

# ==============================================
# SERVER CONFIGURATION
# ==============================================

# CORS Settings
CORS_ORIGINS="http://localhost:3000,http://localhost:3001,http://localhost:5173"
CORS_METHODS="GET,HEAD,PUT,PATCH,POST,DELETE,OPTIONS"
CORS_CREDENTIALS=true

# Rate Limiting
THROTTLE_TTL=60
THROTTLE_LIMIT=100
THROTTLE_SKIP_IF="127.0.0.1"

# Request Limits (in bytes)
MAX_FILE_SIZE=5242880
MAX_REQUEST_SIZE=10485760

# ==============================================
# LOGGING CONFIGURATION
# ==============================================

# Logging
LOG_LEVEL="debug"
LOG_FORMAT="combined"
LOG_FILE_ENABLED=true
LOG_FILE_PATH="logs/app.log"
# ==============================================
# EMAIL CONFIGURATION (Optional)
# ==============================================

# Email Provider (sendgrid, ses, smtp)
EMAIL_PROVIDER=smtp
EMAIL_FROM="noreply@yourdomain.com"
EMAIL_FROM_NAME="Your App Name"

# SMTP Configuration (if using SMTP)
SMTP_HOST="localhost"
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=""
SMTP_PASS=""

# SendGrid (if using SendGrid)
SENDGRID_API_KEY=""

# AWS SES (if using AWS SES)
AWS_REGION="us-east-1"
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""

# ==============================================
# REDIS CONFIGURATION (Optional)
# ==============================================

# Redis for Caching
REDIS_HOST="localhost"
REDIS_PORT=6379
REDIS_PASSWORD=""
REDIS_DB=0
REDIS_TTL=3600

# ==============================================
# FILE STORAGE CONFIGURATION
# ==============================================

# File Upload
UPLOAD_DESTINATION="uploads"
UPLOAD_MAX_FILES=10
UPLOAD_ALLOWED_EXTENSIONS="jpg,jpeg,png,pdf,doc,docx"

# ==============================================
# DEVELOPMENT TOOLS
# ==============================================

# API Documentation
SWAGGER_ENABLED=true
SWAGGER_PATH="docs"
SWAGGER_TITLE="Your API Title"
SWAGGER_DESCRIPTION="API documentation for your application"
SWAGGER_VERSION="1.0.0"

# Health Check
HEALTH_CHECK_ENABLED=true
HEALTH_CHECK_PATH="health"

# ==============================================
# EXTERNAL SERVICES (Optional)
# ==============================================

# Example: Payment Gateway
# STRIPE_SECRET_KEY=""
# STRIPE_PUBLISHABLE_KEY=""
# STRIPE_WEBHOOK_SECRET=""

# Example: Social Auth
# GOOGLE_CLIENT_ID=""
# GOOGLE_CLIENT_SECRET=""
# FACEBOOK_APP_ID=""
# FACEBOOK_APP_SECRET=""

# Security
BCRYPT_ROUNDS=12
PASSWORD_MIN_LENGTH=8

# API Documentation
SWAGGER_TITLE=Broy NestJS Starter MVP API
SWAGGER_DESCRIPTION=Comprehensive NestJS starter template API documentation
SWAGGER_VERSION=1.0.0

# Feature Flags
ENABLE_SWAGGER=true
ENABLE_EMAIL_VERIFICATION=true
ENABLE_FILE_UPLOAD=true
ENABLE_PUSH_NOTIFICATIONS=false

# Monitoring & Analytics
SENTRY_DSN=your-sentry-dsn-here

# Third-party Services
GOOGLE_CLIENT_ID=your-google-oauth-client-id
GOOGLE_CLIENT_SECRET=your-google-oauth-client-secret

GITHUB_CLIENT_ID=your-github-oauth-client-id
GITHUB_CLIENT_SECRET=your-github-oauth-client-secret
