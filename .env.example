# Application Configuration
NODE_ENV=development
PORT=3000
API_PREFIX=api/v1
BASE_URL=http://localhost:3000
FRONTEND_URL=http://localhost:3001
TIMEZONE=UTC

# Database Configuration
DATABASE_URL="postgresql://postgres:password@localhost:5432/broy_starter_dev"

# JWT Configuration
JWT_SECRET=your-super-secret-jwt-key-change-in-production-very-long-and-secure
JWT_REFRESH_SECRET=your-super-secret-refresh-jwt-key-change-in-production-very-long-and-secure
JWT_EXPIRES_IN=60m
JWT_REFRESH_EXPIRES_IN=7d

# CORS Configuration
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# Rate Limiting Configuration
THROTTLE_TTL=60
THROTTLE_LIMIT=100

# Logging Configuration
LOG_LEVEL=debug

# Email Configuration (Choose one provider)
# SendGrid
SENDGRID_API_KEY=your-sendgrid-api-key

# AWS SES
AWS_ACCESS_KEY_ID=your-aws-access-key
AWS_SECRET_ACCESS_KEY=your-aws-secret-key
AWS_REGION=us-east-1
AWS_SES_FROM_EMAIL=noreply@yourdomain.com

# Redis Configuration (if using Redis for caching)
REDIS_URL=redis://localhost:6379
REDIS_PASSWORD=

# File Upload Configuration
MAX_FILE_SIZE=5242880
UPLOAD_DEST=./uploads
ALLOWED_MIME_TYPES=image/jpeg,image/png,image/gif,application/pdf

# Push Notification Configuration
# Firebase
FIREBASE_SERVER_KEY=your-firebase-server-key
FIREBASE_PROJECT_ID=your-firebase-project-id

# Security
BCRYPT_ROUNDS=12
PASSWORD_MIN_LENGTH=8

# API Documentation
SWAGGER_TITLE=Broy NestJS Starter MVP API
SWAGGER_DESCRIPTION=Comprehensive NestJS starter template API documentation
SWAGGER_VERSION=1.0.0

# Feature Flags
ENABLE_SWAGGER=true
ENABLE_EMAIL_VERIFICATION=true
ENABLE_FILE_UPLOAD=true
ENABLE_PUSH_NOTIFICATIONS=false

# Monitoring & Analytics
SENTRY_DSN=your-sentry-dsn-here

# Third-party Services
GOOGLE_CLIENT_ID=your-google-oauth-client-id
GOOGLE_CLIENT_SECRET=your-google-oauth-client-secret

GITHUB_CLIENT_ID=your-github-oauth-client-id
GITHUB_CLIENT_SECRET=your-github-oauth-client-secret
